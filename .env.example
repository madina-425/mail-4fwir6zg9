AWS_REGION=us-east-1
BEDROCK_MODEL_ID=YOUR_MODEL_ID
# Optional Bedrock API key. Use this instead of AWS access key variables.
# AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-...
MAX_TOKENS=1200

# Optional: use long-lived IAM access keys instead of the AWS credential chain.
# Never commit real values to Git.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
